{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "state.yaml — project state (active memory only)",
 "type": "object",
 "required": [
  "direction",
  "tasks"
 ],
 "additionalProperties": false,
 "properties": {
  "direction": {
   "type": "object",
   "required": [
    "text"
   ],
   "additionalProperties": false,
   "properties": {
    "text": {
     "type": "string"
    },
    "criteria": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "tasks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "status",
     "assigner",
     "executor",
     "done_when"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "status": {
      "enum": [
       "čarha",
       "praca",
       "pauza",
       "pieraškoda"
      ]
     },
     "assigner": {
      "type": "string"
     },
     "executor": {
      "type": "string"
     },
     "acceptor": {
      "type": "string"
     },
     "done_when": {
      "type": "string"
     },
     "parent": {
      "type": "string"
     },
     "depends_on": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "priority": {
      "type": "integer"
     },
     "matter": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
     }
    }
   }
  },
  "open_items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "text",
     "kind"
    ],
    "additionalProperties": false,
    "properties": {
     "text": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "niaviedannie",
       "dvuznačnasć",
       "patreba.rašennie"
      ]
     },
     "task": {
      "type": "string"
     },
     "origin": {
      "enum": [
       "zajava",
       "rašennie",
       "vyvad"
      ]
     }
    }
   }
  },
  "artifacts": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "progress": {
   "type": "object",
   "properties": {
    "V": {
     "type": "number"
    },
    "failing": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "summary": {
   "type": "string"
  }
 }
}